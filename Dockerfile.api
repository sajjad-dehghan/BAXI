FROM python:3.12-slim
ARG PIP_INDEX_URL=https://pypi.org/simple
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt && useradd --uid 10001 --create-home baxi
COPY src ./src
COPY scripts/seed_demo.py ./scripts/seed_demo.py
COPY scripts/start_api.py ./scripts/start_api.py
COPY assets ./assets
RUN mkdir -p data/uploads && chown -R baxi:baxi /app
USER baxi
EXPOSE 8000
CMD ["python", "scripts/start_api.py"]

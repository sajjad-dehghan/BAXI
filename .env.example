# Local development only. Copy to .env. Never use these demo passwords remotely.
BAXI_DB_HOST=127.0.0.1
BAXI_DB_PORT=3307
BAXI_DB_USER=baxi
BAXI_DB_PASSWORD=baxi-local-demo-only
# Demo mode uses offline addresses, console OTPs and simulated wallet deposits.
BAXI_DEMO_MODE=true
NESHAN_API_KEY=
# Enable only behind HTTPS. Sessions are process-local; use one API worker.
BAXI_COOKIE_SECURE=false
BAXI_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173,http://localhost:8080,http://127.0.0.1:8080

# Explicit public-place search only; single API worker, cached and <=1 upstream request/sec.
BAXI_GEOCODER_URL=https://nominatim.openstreetmap.org

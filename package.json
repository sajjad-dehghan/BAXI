{
  "name": "baxi-pwa",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "node frontend/scripts/pwa.mjs icons && vite --config frontend/vite.config.ts --host 127.0.0.1",
    "build": "node frontend/scripts/pwa.mjs icons && tsc --project frontend/tsconfig.json --noEmit && vite build --config frontend/vite.config.ts && node frontend/scripts/pwa.mjs worker",
    "preview": "vite preview --config frontend/vite.config.ts --host 127.0.0.1",
    "test:e2e": "playwright test --config frontend/playwright.config.ts",
    "format": "prettier --write frontend/src frontend/tests frontend/scripts frontend/*.ts",
    "format:check": "prettier --check frontend/src frontend/tests frontend/scripts frontend/*.ts"
  },
  "dependencies": {
    "@fontsource/vazirmatn": "^5.3.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.52.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "vite": "^8.3.3"
  }
}
